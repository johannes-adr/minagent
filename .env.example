# Generated by `agent --env-example`; copy to .env and fill in.

# LLM backend: ollama, anthropic or openai
LLM_BACKEND=openai

# Model name; empty uses the backend's default
LLM_MODEL=

# OpenAI API key (required for the openai backend)
OPENAI_API_KEY=

# OpenAI-compatible API base URL; empty uses the official API
OPENAI_BASE_URL=

# Anthropic API key (required for the anthropic backend)
ANTHROPIC_API_KEY=

# Anthropic API base URL; empty uses the official API
ANTHROPIC_BASE_URL=

# Ollama daemon URL; empty uses http://localhost:11434
OLLAMA_API_BASE_URL=

# Ollama token, only for authenticated/proxied daemons
OLLAMA_API_KEY=
