# Generated by `agent --env-example`; copy to .env and fill in.

# LLM backend: ollama, anthropic or openai
LLM_BACKEND=openai

# Model name; empty uses the backend's default
LLM_MODEL=

# OpenAI API key (required for the openai backend)
OPENAI_API_KEY=

# OpenAI-compatible API base URL; empty uses the official API
OPENAI_BASE_URL=

# Anthropic API key (required for the anthropic backend)
ANTHROPIC_API_KEY=

# Anthropic API base URL; empty uses the official API
ANTHROPIC_BASE_URL=

# Ollama daemon URL; empty uses http://localhost:11434
OLLAMA_API_BASE_URL=

# Ollama token, only for authenticated/proxied daemons
OLLAMA_API_KEY=

# Comma-separated tools to enable (execute, use_skill, agent, execute_javascript, view_image); empty enables all
AGENT_TOOLS=

# execute_javascript (unless built with --no-default-features): comma-separated hosts its scripts may contact without asking
AGENT_JS_ALLOWED_HOSTS=

# execute_javascript: a secret named GITHUB as `<host> <Authorization header value>`, e.g. `api.github.com Bearer ghp_xxx`; scripts use it with fetch(..., {secret: "GITHUB"}) and never see the value. Add more as AGENT_SECRET_<NAME>
AGENT_SECRET_GITHUB=

# Built-in skill `paperless`: the Paperless-ngx API token (web UI: My Profile) as `<host> Token <token>`, e.g. `paperless.example.com Token 0123abc`. Add the host to AGENT_JS_ALLOWED_HOSTS to skip approvals
AGENT_SECRET_PAPERLESS=
